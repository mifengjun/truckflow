      "description": "Observed Button variant; no invented active-state animation.",
      "html": "<button class=\"ds-button-ghost\">查看详情</button>",
      "css": ".ds-button-ghost{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid transparent;border-radius:4px;font-size:13px;font-weight:550;white-space:nowrap;cursor:pointer;background:transparent;color:var(--primary,#2856a3);}.ds-button-ghost:focus-visible{outline:3px solid var(--focus,#82aaff);outline-offset:3px;}.ds-button-ghost:disabled{opacity:.5;cursor:not-allowed;}@media(max-width:760px){.ds-button-ghost{min-height:44px;}}.ds-button-ghost{transition:background-color 140ms,border-color 140ms}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
    },
    {
      "name": "Button / danger",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Observed Button variant; no invented active-state animation.",
      "html": "<button class=\"ds-button-danger\">确认重置</button>",
      "css": ".ds-button-danger{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:8px 16px;border:1px solid transparent;border-radius:4px;font-size:13px;font-weight:550;white-space:nowrap;cursor:pointer;background:#b42318;color:#fff;}.ds-button-danger:focus-visible{outline:3px solid var(--focus,#82aaff);outline-offset:3px;}.ds-button-danger:disabled{opacity:.5;cursor:not-allowed;}@media(max-width:760px){.ds-button-danger{min-height:44px;}}.ds-button-danger{transition:background-color 140ms,border-color 140ms}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "Visible label with associated hint and error-border support.",
      "html": "<div class=\"ds-field\"><label for=\"ds-address\">收货地址</label><input class=\"ds-input\" id=\"ds-address\" aria-describedby=\"ds-help\" placeholder=\"填写完整地址\"><p id=\"ds-help\">包含街道、城市及邮编</p></div>",
      "css": ".ds-field{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;color:var(--foreground,#243342)}.ds-field label{display:block;font-size:12px;font-weight:500;margin-bottom:7px}.ds-input{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;width:100%;min-height:40px;padding:8px 12px;border:1px solid #cdd5e1;border-radius:4px;background:#fff;color:var(--foreground,#243342);font-size:14px}.ds-input::placeholder{color:#647186}.ds-input:focus-visible{outline:3px solid var(--focus,#82aaff);outline-offset:3px;}.ds-input[aria-invalid=\"true\"]{border-color:#b42318}.ds-field p{font-size:12px;color:var(--muted,#526071);margin:5px 0 0}@media(max-width:760px){.ds-input{min-height:44px}}.ds-input{transition:border-color 140ms}.ds-input:hover{border-color:#8d9db1}@media(prefers-reduced-motion:reduce){*{transition:none!important}}"
    },
    {
      "name": "Sidebar navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Current link, ordinary link, hover and keyboard focus.",
      "html": "<nav class=\"ds-nav\" aria-label=\"客户工作区\"><a href=\"#orders\" aria-current=\"page\">我的订单</a><a href=\"#inquiries\">询价记录</a></nav>",
      "css": ".ds-nav{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;background:var(--navigation,#1b2a3a);padding:12px;display:grid;gap:3px;font-size:14px}.ds-nav a{height:42px;padding:0 12px;display:flex;align-items:center;border-radius:4px;color:#bcc9d8;text-decoration:none;transition:background-color 140ms,color 140ms}.ds-nav a:hover{background:#2a3d51;color:#fff}.ds-nav a[aria-current]{background:#344b65;color:#fff;font-weight:600}.ds-nav a:focus-visible{outline:3px solid #82aaff;outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Pending status badge",
      "kind": "chip",
      "refersTo": "badge-warning",
      "description": "Noninteractive semantic status with a visible label.",
      "html": "<span class=\"ds-badge\"><span aria-hidden=\"true\"></span>等待承运商确认</span>",
      "css": ".ds-badge{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:500;white-space:nowrap;padding:3px 8px;border-radius:4px;background:#fff4de;color:#925c0a}.ds-badge>span{width:5px;height:5px;border-radius:50%;background:currentColor}"
    },
    {
      "name": "Information panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "General standalone panel, distinct from continuous inquiry sections and quote rows.",
      "html": "<section class=\"ds-panel\"><h2>提货信息</h2><p>洛杉矶仓 · 美国</p></section>",
      "css": ".ds-panel{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;background:var(--surface,#fff);color:var(--foreground,#243342);border:1px solid var(--line,#dfe4ec);border-radius:var(--radius,5px);padding:24px}.ds-panel h2{font-size:15px;font-weight:650;margin:0 0 20px;padding-bottom:14px;border-bottom:1px solid #dfe4e9}.ds-panel p{font-size:14px;margin:0;color:var(--muted,#526071)}@media(max-width:760px){.ds-panel{padding:18px}}"
    },
    {
      "name": "Operations queue strip",
      "kind": "custom",
      "refersTo": "queue-action",
      "description": "Compact business filter buttons; pressed state reflects the order filter. Preview count is sample content.",
      "html": "<section class=\"ds-desk\" aria-label=\"订单处理队列\"><button class=\"ds-queue\" aria-pressed=\"true\"><span><strong>结果待确认</strong><small>优先核实，避免重复提交</small></span><b>2</b></button><button class=\"ds-queue\" aria-pressed=\"false\"><span><strong>待审核</strong><small>核对运输资料后提交</small></span><b>3</b></button></section>",
      "css": ".ds-desk{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;display:flex;padding:12px 0;border-top:1px solid #d3dae3;border-bottom:1px solid #d3dae3;background:var(--background,#f5f6f7);color:var(--foreground,#243342)}.ds-queue{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;display:flex;align-items:center;gap:10px;flex:1;min-width:0;padding:8px 20px;border:0;border-left:1px solid #d3dae3;text-align:left;background:transparent;color:inherit;cursor:pointer}.ds-queue strong{font-size:13px;font-weight:600}.ds-queue small{display:block;margin-top:3px;font-size:12px;color:#526071}.ds-queue b{margin-left:auto;font-size:20px;font-weight:600;font-variant-numeric:tabular-nums}.ds-queue:hover,.ds-queue[aria-pressed=\"true\"]{background:#e7edf5}.ds-queue:focus-visible{outline:3px solid #82aaff;outline-offset:3px;}@media(max-width:1100px){.ds-queue{padding:8px 12px}.ds-queue:first-child{border-left:0}.ds-queue small{display:none}}@media(max-width:760px){.ds-desk{padding:4px 0}.ds-queue{padding:10px 8px;flex-wrap:wrap;gap:5px}.ds-queue strong{font-size:12px}.ds-queue b{font-size:16px}}"
    },
    {
      "name": "Continuous quote row",
      "kind": "custom",
      "refersTo": "quote-row",
      "description": "Aligned carrier, time, amount and action within a continuous bordered list.",
      "html": "<div class=\"ds-quotes\"><article class=\"ds-quote\"><div class=\"ds-quote-main\"><div><h2>示例承运商</h2><small>标准零担 · 方案 01</small></div><div><small>参考时效</small><p>2–3 个工作日</p></div><div class=\"ds-price\"><small>总价 · USD</small><strong>385.00</strong></div><button class=\"ds-choose\">选择报价</button></div><details class=\"ds-fees\"><summary>查看费用明细</summary><p>示例运费 · USD 385.00</p></details></article></div>",
      "css": ".ds-quotes{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;border:1px solid #cfd7e1;border-radius:4px;overflow:hidden;color:var(--foreground,#243342)}.ds-quote{background:#fff;border:0;border-radius:0}.ds-quote+.ds-quote{border-top:1px solid #cfd7e1}.ds-quote-main{display:grid;grid-template-columns:minmax(180px,1.5fr) 1fr 1fr auto;gap:24px;align-items:center;padding:24px}.ds-quote h2{font-size:16px;font-weight:650;margin:0}.ds-quote small{font-size:12px;color:var(--muted,#526071)}.ds-quote p{font-size:14px;margin:6px 0 0}.ds-price{text-align:right}.ds-price strong{display:block;font-size:26px;font-weight:600;letter-spacing:-.5px;font-variant-numeric:tabular-nums}.ds-choose{font-family:Arial,\"PingFang SC\",\"Microsoft YaHei\",sans-serif;line-height:1.6;border:1px solid transparent;border-radius:4px;min-height:40px;min-width:116px;padding:8px 16px;font-size:13px;font-weight:550;background:var(--primary,#2856a3);color:#fff;cursor:pointer;transition:background-color 140ms,border-color 140ms}.ds-choose:hover{background:var(--primary-hover,#1c407e)}.ds-choose:focus-visible,.ds-fees summary:focus-visible{outline:3px solid #82aaff;outline-offset:3px;}.ds-fees{background:#fafbfc;padding:9px 24px;border-top:1px solid #e5e9ee}.ds-fees[open]{background:#f1f4f8}.ds-fees summary{font-size:12px;color:var(--primary,#2856a3);cursor:pointer}@media(max-width:1100px){.ds-quote-main{grid-template-columns:1.4fr 1fr 1fr;gap:20px}.ds-choose{grid-column:3}}@media(max-width:760px){.ds-quote-main{padding:20px;grid-template-columns:1fr 1fr}.ds-choose{grid-column:span 2;min-height:44px}.ds-fees{padding:10px 20px}}@media(prefers-reduced-motion:reduce){.ds-choose{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "物流业务工作台",
    "overview": "以真实物流业务工具为准：深海军蓝导航稳定页面骨架，浅中性工作区承载订单与单据，克制的蓝色用于操作。连续表单、对齐报价行和横向待办队列把用户注意力留给对象、状态和下一步。\n\n视觉升级遵循已确认的纠正方向：不使用膨胀的任务卡、营销式标题或重复圆角面板。客户和运营共享系统中文字体、细边线与状态语义；数值来自原型记录，业务内容比装饰优先。记录依据最终 CSS 层叠和现有组件，视觉方向见 .impeccable/surfaces/visual-upgrade.md。",
    "keyCharacteristics": [
      "深色导航与中性工作区形成稳定骨架。",
      "连续单据式表单、连续报价行、紧凑横向待办条。",
      "常用控件 4px、通用面板 5px 圆角；用边线组织内容。",
      "金额等宽数字、完整地址换行、状态保留文字。"
    ],
    "rules": [
      {
        "name": "The Operational Color Rule",
        "body": "深色导航承载定位，操作蓝承载行动；业务状态使用独立语义色和文字。",
        "section": "colors"
      },
      {
        "name": "The Legible Detail Rule",
        "body": "辅助文字至少 12px，金额和数量采用等宽数字，完整地址允许换行。",
        "section": "typography"
      },
      {
        "name": "The Document Surface Rule",
        "body": "连续业务资料通过边线分组，报价通过连续行比较，避免重复卡片制造层级。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用深色导航、克制的操作蓝和中性业务内容区。",
      "Do 用连续表单、对齐数据行和细分隔线组织复杂任务。",
      "Do 让待办条筛选已有订单，保留按下状态和可见键盘焦点。",
      "Do 显示币种、单位、时区和状态文字；金额采用 tabular-nums。"
    ],
    "donts": [
      "Don’t 使用膨胀任务卡、营销式标题、重复圆角面板或装饰性图标色块。",
      "Don’t 添加渐变、装饰地图或虚构指标来填充业务页面。",
      "Don’t 仅靠颜色表达状态或错误，或添加标题眉题。",
      "Don’t 将最低报价视觉包装成承运商推荐。"
    ]
  }
}
