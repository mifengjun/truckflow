# Copy to .env.local and configure a DEVELOPMENT/TEST project only.
# Do not put real credentials in this tracked template.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Auth administration; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Dedicated, restricted runtime DB role. Connection mode must be verified.
DATABASE_URL=
# Migration connection with schema management privileges. Not used by runtime.
MIGRATION_DATABASE_URL=

APP_ENV=development
# Public CA certificate must be bundled for Vercel server functions.
DATABASE_SSL_CA_PATH=supabase-ca.crt
# Enable only after SMTP, verification callback URLs and email delivery are verified.
REGISTRATION_ENABLED=false
